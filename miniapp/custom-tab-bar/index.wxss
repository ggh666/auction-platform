.tab-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 9999;
  display: flex;
  box-sizing: border-box;
  min-height: 112rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background:
    linear-gradient(180deg, rgba(7, 17, 18, 0.96), #031010);
  background-color: #031010;
  border-top: 1px solid rgba(246, 196, 83, 0.14);
  box-shadow: 0 -16rpx 36rpx rgba(0, 0, 0, 0.34);
}

.tab-item {
  position: relative;
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 112rpx;
}

.tab-item.active::before {
  position: absolute;
  top: 18rpx;
  left: 50%;
  width: 44rpx;
  height: 4rpx;
  background: #f6c453;
  border-radius: 4rpx;
  box-shadow: 0 0 18rpx rgba(246, 196, 83, 0.72);
  transform: translateX(-50%);
  content: "";
}

.tab-text {
  color: #8aa196;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 56rpx;
}

.tab-item.active .tab-text {
  color: #f6c453;
}
