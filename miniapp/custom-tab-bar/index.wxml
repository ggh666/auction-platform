<view class="tab-bar">
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="tab-item {{selected === index ? 'active' : ''}}"
    hover-class="tab-item-hover"
    hover-stay-time="80"
    data-index="{{index}}"
    data-path="{{item.pagePath}}"
    bindtap="switchTab"
  >
    <view class="tab-surface">
      <view class="tab-indicator"></view>
      <text class="tab-text">{{item.text}}</text>
    </view>
  </view>
</view>
