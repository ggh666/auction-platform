.tab-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 9999;
  display: flex;
  box-sizing: border-box;
  min-height: 112rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background:
    linear-gradient(180deg, rgba(7, 17, 18, 0.96), #031010);
  background-color: #031010;
  border-top: 1px solid rgba(246, 196, 83, 0.14);
  box-shadow: 0 -16rpx 36rpx rgba(0, 0, 0, 0.34);
}

.tab-item {
  position: relative;
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 112rpx;
}

.tab-surface {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 188rpx;
  height: 76rpx;
  border-radius: 8rpx;
  transition: transform 120ms ease, background 120ms ease;
}

.tab-indicator {
  position: absolute;
  top: 8rpx;
  left: 50%;
  width: 42rpx;
  height: 4rpx;
  background: transparent;
  border-radius: 4rpx;
  transform: translateX(-50%);
}

.tab-item-hover .tab-surface {
  background: rgba(246, 196, 83, 0.10);
  transform: scale(0.96);
}

.tab-item.active .tab-surface {
  background: rgba(246, 196, 83, 0.14);
  box-shadow: inset 0 0 0 1px rgba(246, 196, 83, 0.26);
}

.tab-item.active .tab-indicator {
  background: #f6c453;
  box-shadow: 0 0 18rpx rgba(246, 196, 83, 0.72);
}

.tab-text {
  color: #8aa196;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 52rpx;
  transition: color 120ms ease, transform 120ms ease;
}

.tab-item.active .tab-text {
  color: #f6c453;
  transform: translateY(2rpx);
}
