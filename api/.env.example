# API runtime environment. Frontend builds also need VITE_API_BASE or UNI_APP_API_BASE.
NODE_ENV=production
LOG_LEVEL=warn
HOST=0.0.0.0
PORT=3002
API_PUBLIC_BASE_URL=https://api-auction.toolmatrix.top
API_SLOW_REQUEST_THRESHOLD_MS=800
JWT_SECRET=replace-with-a-long-random-secret
MYSQL_URI=mysql://auction_user:replace-password@127.0.0.1:3306/auction_platform
MYSQL_CONNECTION_LIMIT=10
MYSQL_MAX_IDLE=2
MYSQL_IDLE_TIMEOUT_MS=60000
R2_ENDPOINT=https://replace-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-access-key-id
R2_SECRET_ACCESS_KEY=replace-secret-access-key
R2_BUCKET=auction-assets
WECHAT_APPID=replace-wechat-mini-program-appid
WECHAT_APP_SECRET=replace-wechat-mini-program-secret
WECHAT_EVENT_TOKEN=replace-wechat-message-push-token
WECHAT_PRICE_CHANGE_SUBSCRIBE_TEMPLATE_ID=replace-price-change-subscribe-template-id
WECHAT_ASSET_MESSAGE_SUBSCRIBE_TEMPLATE_ID=replace-asset-message-subscribe-template-id
WECHAT_SUBSCRIBE_MESSAGE_MINIPROGRAM_STATE=formal
CONTENT_SAFETY_ENABLED=true
CONTENT_SAFETY_STRICT=true
